# Copy to .env and fill in. .env is git-ignored.

# --- Portal ---
PORTAL_BASE_URL=https://aranyavihaara.karnataka.gov.in
# Set these after recon maps the real endpoints (see recon/README.md)
PORTAL_AVAILABILITY_PATH=/TODO/availability
PORTAL_BOOKING_PATH=/TODO/booking

# --- Release schedule (verify in recon; design doc says 15 days ahead) ---
RELEASE_DAYS_AHEAD=15
# Local (IST) time of day new dates become bookable, HH:MM:SS
RELEASE_TIME_IST=00:00:00
# Start the tight poll loop this many seconds before the release time
RELEASE_LEAD_SECONDS=5

# --- Watcher ---
# Polite polling interval while idle (ms). Tight loop interval near release (ms).
WATCH_IDLE_INTERVAL_MS=30000
WATCH_TIGHT_INTERVAL_MS=250

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Infra (docker-compose defaults) ---
DATABASE_URL=postgres://ktb:ktb@localhost:5432/ktb
REDIS_URL=redis://localhost:6379

# --- Safety ---
# true = never submit a real booking; log the payload instead
DRY_RUN=true
LOG_LEVEL=info
